{
	# We remove 'auto_https off' so Caddy can automatically fetch certificates!
	# The CDN edge domains use `tls internal`; never try to install the local
	# root CA into the OS trust store (the caddy service user has no sudo,
	# and the CDN does its own origin verification anyway).
	skip_install_trust

	# Enables verbose DEBUG logging
	# debug

	# Offer HTTP/1.1 + HTTP/2 during TLS negotiation (Port 443). h2 lets
	# apex visitors multiplex API/static over one connection; the CDN
	# edge keeps using HTTP/1.1 for origin fetches by default, so this does
	# not change the edge->origin leg. h3 is intentionally left off.
	servers {
		protocols h1 h2
	}
}

# 1. Direct Origin Domain (Public Let's Encrypt Cert)
drone-navigation.com {
	# MediaMTX Control API (proxied across ECS servers to 47.85.110.135)
	handle_path /control-api/* {
		reverse_proxy 47.85.110.135:9997 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# FastAPI backend (auth/users/settings; plain `handle` keeps the /api
	# prefix — FastAPI routes include it)
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Synapse Matrix client API (over the Tailscale mesh to ECS 2; plain
	# `handle` keeps the /_matrix prefix — Synapse routes include it)
	handle /_matrix/* {
		reverse_proxy 100.68.213.55:8008 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Strip the '/live' prefix before sending the request to MediaMTX
	handle_path /live/* {
		reverse_proxy 47.85.110.135:8889 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}

			# Ensure internal MediaMTX redirects maintain the /live/ subpath
			header_down Location ^/ /live/

			# MediaMTX <= v1.11 ties a WHIP/WHEP WebRTC session to the lifetime
			# of this proxied HTTP connection: when the idle upstream connection
			# is reaped (~90 s default), the WebRTC session dies with it. Keep
			# upstream connections alive far longer; dead sessions are still
			# reaped by MediaMTX's own PeerConnection monitoring, so no leak.
			transport http {
				keepalive 24h
			}
		}
	}

	# Game packages workspace (repo-root games/ -> /var/www/drone-navigation/
	# games/). Deliberately OUTSIDE the client/dist static root below: the
	# packages are the mutable, fragile half of the site and the engine bundle
	# is the stable half, so a broken package cannot break an app deploy and
	# editing a package needs no rebuild.
	#
	# Two tiers, expressed as two `handle` blocks with LITERAL path matchers so
	# the outcome depends only on Caddy's documented specificity sort (longest
	# single path matcher first, matcher-less fallback last) and not on source
	# order. Without the /games/catalog.json block a request for it would fall
	# through to `try_files {path} /index.html` and return the SPA instead of
	# JSON.
	handle /games/catalog.json {
		root * /var/www/drone-navigation

		# The client pins /games/* to the apex (the CDN edge must not cache the
		# catalog), so an edge visitor's fetch is cross-origin. These files are
		# public, unauthenticated and credential-free, so `*` is correct and
		# avoids echoing arbitrary Origins.
		header Access-Control-Allow-Origin "*"

		# The index is the ONE file that must never be served from cache: it is
		# what makes a game appear, disappear or move. `no-cache` still stores
		# it, so an unchanged catalog costs a 304 with an empty body — Caddy's
		# file_server sends the ETag.
		header Cache-Control "no-cache"

		encode gzip zstd
		file_server
	}

	handle /games/* {
		root * /var/www/drone-navigation
		header Access-Control-Allow-Origin "*"

		# Package contents: card.json plus the trailer / poster / meshes that
		# will follow. Cacheable but deliberately NOT `immutable` — packages are
		# addressed by id rather than by version, so `immutable` would pin a
		# replaced trailer in returning browsers for a year. card.json is
		# additionally fetched as `card.json?v=<packageVersion>`, so bumping the
		# version in catalog.json busts a card hot-fix immediately; this
		# max-age is the bound on the damage if someone forgets to bump it.
		# Once packages move to version-addressed CDN URLs (the catalog's
		# baseUrl field already supports them) this can become
		# "public, max-age=31536000, immutable".
		header Cache-Control "public, max-age=86400"

		# Compresses card.json; video/glb are not in Caddy's default encodable
		# content-type list, so they pass through untouched.
		encode gzip zstd
		file_server
	}

	# Self-hosted CesiumJS (client/public/cesium -> dist/cesium), served from our
	# own origin instead of the cesium.com CDN so it is cacheable on our edge,
	# gzip/zstd-compressed, and not a blocking third-party hop through the
	# visitor's VPN. The files are NOT content-hashed (Cesium.js, Workers/*,
	# Assets/* keep fixed names), so this is deliberately max-age WITHOUT
	# `immutable`: a Cesium version bump (pinned in client/package.json) reuses
	# the same URLs, and `immutable` would pin the stale build in returning
	# browsers for a year. 7 days bounds that staleness; purge the CDN edge on a
	# version bump to propagate a new Cesium immediately.
	handle /cesium/* {
		root * /var/www/drone-navigation/client/dist
		header Cache-Control "public, max-age=604800"
		encode gzip zstd
		file_server
	}

	# Serve Static Web App
	handle {
		root * /var/www/drone-navigation/client/dist
		file_server
		encode gzip zstd
		try_files {path} /index.html
	}
}

# 2. CDN Edge Domains (Serves HTTPS origin fetches using Caddy's internal TLS certificate)
www.drone-navigation.com, cdn.drone-navigation.com {
	tls internal

	# FastAPI backend (identical to the apex block; the CDN in front
	# forwards /api/* to the origin unchanged). Kept as the fallback path
	# for old cached SPA builds that still fetch same-origin.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Synapse Matrix client API (identical to the apex block; over the
	# Tailscale mesh to ECS 2)
	handle /_matrix/* {
		reverse_proxy 100.68.213.55:8008 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Game packages workspace — identical to the two apex blocks, kept so that
	# a direct hit on an edge domain serves the file instead of falling through
	# to the SPA catch-all. The client normally pins these requests to the
	# apex, so this path is for stale cached builds and direct navigation.
	handle /games/catalog.json {
		root * /var/www/drone-navigation
		header Access-Control-Allow-Origin "*"
		header Cache-Control "no-cache"
		encode gzip zstd
		file_server
	}

	handle /games/* {
		root * /var/www/drone-navigation
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=86400"
		encode gzip zstd
		file_server
	}

	# Self-hosted CesiumJS — identical to the apex block, kept so a direct hit on
	# an edge domain serves the file (cacheably) instead of falling through to the
	# SPA catch-all. See the apex block for the full rationale.
	handle /cesium/* {
		root * /var/www/drone-navigation/client/dist
		header Cache-Control "public, max-age=604800"
		encode gzip zstd
		file_server
	}

	# Static Web App — MUST stay inside a catch-all handle{} block: a
	# top-level try_files runs before `handle` matching and would rewrite
	# unmatched paths to /index.html ahead of the proxied routes.
	handle {
		root * /var/www/drone-navigation/client/dist
		file_server
		encode gzip zstd
		try_files {path} /index.html
	}
}
