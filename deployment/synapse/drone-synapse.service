[Unit]
Description=Synapse Matrix homeserver (drone-navigation Community chat)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/synapse-data

# Set environment PATH so Conda packages & Python binaries load correctly
Environment="PATH=/root/miniconda3/envs/synapse/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Absolute path to the Conda environment's python executable
ExecStart=/root/miniconda3/envs/synapse/bin/python -m synapse.app.homeserver -c /root/synapse-data/homeserver.yaml
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
