# FastAPI backend (auth + settings + Matrix brokering, port 8000).
# --reload is kept for dev ergonomics: .py edits auto-apply;
# config.json edits still need `touch app/main.py` (watches .py only).
# NOTE: the conda env below is still named `drone-navigation`. That name is
# unrelated to the repo path and is shared with the production unit, so it must
# NOT be "fixed" during a rename sweep.
[Unit]
Description=FastAPI backend (real-world-disaster-game, port 8000)
After=drone-pg.service
Wants=drone-pg.service

[Service]
Type=simple
WorkingDirectory=%h/real-world-disaster-game/server
ExecStart=%h/miniconda3/envs/drone-navigation/bin/uvicorn app.main:app --reload --port 8000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
